{
    "name": "beryllium/cache",
    "description": "Provides a PHP interface to numerous caching implementations",
    "keywords": ["memcache", "cache", "memcached", "apc"],
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Kevin Boyd (aka Beryllium)",
            "homepage": "https://whateverthing.com/"
        },
        {
            "name": "Jeremy Livingston",
            "homepage": "https://github.com/jeremylivingston"
        },
        {
            "name": "Nechaev Yaroslav",
            "homepage": "https://github.com/Remper"
        }
    ],
    "require":
    {
        "php": ">=8.1.0",
        "psr/simple-cache": "^1.0"
    },
    "require-dev":
    {
        "mikey179/vfsstream": "^v1.6",
        "phpunit/phpunit": "^9.6",
        "ext-memcached": "*",
        "ext-apcu": "*",
        "rector/rector": "^2.2",
        "phpunit/php-code-coverage": "^9.2.31",
        "phpunit/php-file-iterator": "^3.0.6",
        "phpunit/php-text-template": "^2.0.4",
        "phpunit/php-timer": "^5.0.3"
    },
    "autoload":
    {
        "psr-4": { "Beryllium\\Cache\\": "src/" }
    },
    "autoload-dev":
    {
        "psr-4": { "Beryllium\\Cache\\Tests\\": "tests/" }
    },
    "scripts": {
        "test": [
            "php -dapc.enable_cli=1 vendor/bin/phpunit"
        ]
    }
}
